{
  "description": "Surfaces in-flight squad stories and pending gates at session start.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/squad-session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
